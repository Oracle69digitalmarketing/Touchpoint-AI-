# ─────────────────────────────────────────────
# SERVER-SIDE ONLY — never referenced from client code
# ─────────────────────────────────────────────

# GROQ API KEY - Get it from https://console.groq.com/
# Used only by the Express server. NEVER expose this to the client.
# REQUIRED in production (the server refuses to start without it).
GROQ_API_KEY=gsk_...

# Paystack Secret Key - used to call Paystack APIs server-side only.
# REQUIRED in production (billing, webhook signature verification and
# identity resolution all depend on it).
PAYSTACK_SECRET_KEY=sk_test_...

# Optional Paystack recurring plan codes. When set, checkout subscriptions to the
# matching tier use Paystack's recurring billing (monthly). Leave blank to run
# one-time charges instead. Create plans in the Paystack dashboard.
# PAYSTACK_PLAN_CODE_STARTER=PLN_xxx
# PAYSTACK_PLAN_CODE_GROWTH=PLN_xxx
# PAYSTACK_PLAN_CODE_BUSINESS=PLN_xxx

# ─────────────────────────────────────────────
# SERVER CONFIGURATION
# ─────────────────────────────────────────────

# The API server runs on this port. Vite (dev) runs on 3000 and proxies /v1 here.
PORT=3001

# Set to "production" for deployment. Enables: startup environment validation
# (all required keys below), SQLite startup integrity check, and the tighter
# default security posture. Leave as "development" locally.
NODE_ENV=development

# Database connection URL (Phase 8 migration to Neon PostgreSQL).
# When set, the application uses PostgreSQL instead of SQLite.
# Format: postgresql://[user]:[password]@[host]:[port]/[database]?sslmode=require
# DATABASE_URL=

# JWT signing secret for authentication.
# REQUIRED in every mode - the server refuses to start without it.
# Generate one with:  node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
# In production it must be at least 32 characters and not a placeholder.
JWT_SECRET=replace-with-a-long-random-hex-string

# How long a signed-in session lasts, in days (default: 7, range 1-365).
# SESSION_TTL_DAYS=7

# Comma-separated list of browser origins allowed to call the API.
# REQUIRED in production. localhost origins are rejected in production.
CORS_ORIGIN=http://localhost:3000

# Public base URL of the deployed app. Used to build touchpoint destination
# links such as https://app.yourdomain.com/t/TX-abc123 and the Paystack
# checkout callback. REQUIRED in production and must be a valid http(s) URL.
APP_URL=http://localhost:3000

# Directory where the SQLite database file is stored (defaults to ./data).
# The directory is locked down to 0700 and the database to 0600 on startup.
# DATA_DIR=./data

# Optional override for the Express `trust proxy` setting (a hop count, e.g.
# TRUST_PROXY=1 for Render's single reverse proxy hop). Without it, requests
# carrying X-Forwarded-For make express-rate-limit throw
# ERR_ERL_UNEXPECTED_X_FORWARDED_FOR. Production defaults to one trusted hop
# (this project deploys behind Render's proxy); set TRUST_PROXY=0 only when the
# app is truly exposed without a proxy. Never set permissive "true".
# TRUST_PROXY=1

# Disable the SQLite integrity check that runs at startup in production.
# Only set this if the check ever becomes a real cost on a large database.
# DB_SKIP_INTEGRITY_CHECK=1

# ─────────────────────────────────────────────
# CLIENT-SIDE (PUBLIC) — safe to expose in the browser bundle
# ─────────────────────────────────────────────

# Paystack Public Key - safe to include in the client bundle
VITE_PAYSTACK_PUBLIC_KEY=pk_test_...

# ─────────────────────────────────────────────
# RENDER DEPLOYMENT (render.yaml)
# ─────────────────────────────────────────────
# A `render.yaml` blueprint is included. When using Render, set the following
# in the Render dashboard (they are deliberately NOT in render.yaml):
#
#   Required (set manually):
#     GROQ_API_KEY            - https://console.groq.com/
#     PAYSTACK_SECRET_KEY     - Paystack dashboard; also used to verify webhooks
#     APP_URL                 - https://<your-app>.onrender.com  (no trailing slash)
#     CORS_ORIGIN             - same origin as APP_URL, e.g. https://<your-app>.onrender.com
#                               (comma-separate additional origins if you use a custom domain)
#     VITE_PAYSTACK_PUBLIC_KEY - used at BUILD time; must be set before deploy
#
#   Generated automatically:
#     JWT_SECRET              - render.yaml uses `generateValue: true`; Render
#                               creates a strong value once and keeps it stable
#
#   Set automatically by Render (do NOT override):
#     PORT                    - Render injects the port the service listens on
#     NODE_ENV=production     - set explicitly in render.yaml as well
#     DATA_DIR=/data          - render.yaml points at the persistent disk mount
#     TRUST_PROXY=1           - render.yaml sets this so rate limiting sees the
#                               real client IP behind Render's proxy
#
# After deploying, create the Persistent Disk (mount path /data, >= 1GB) so the
# SQLite database survives restarts: it lives at /data/touchpoint.db in WAL mode.
# Backups run against that same directory (`node scripts/backup.js`).
# Health check path: /v1/health
# Paystack webhook URL: https://<your-app>.onrender.com/v1/billing/webhook
